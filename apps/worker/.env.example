# Worker reads root .env for DATABASE_URL and REDIS_URL
LIVENESS_FILE=/tmp/worker-alive

# RSS crawl options
RSS_USER_AGENT=ai-hot-news-bot/0.1
RSS_FETCH_TIMEOUT_MS=15000

# HackerNews Firebase API
HN_FETCH_TIMEOUT_MS=15000
HN_CONCURRENCY=10

# Reddit (public .json endpoint, no OAuth)
# Required: must include "(by /u/<owner-reddit-username>)" per Reddit UA policy.
REDDIT_USER_AGENT=ai-hot-news-bot/0.1 (by /u/anonymous)
REDDIT_FETCH_TIMEOUT_MS=15000
