# === Database ===
POSTGRES_USER=ai_hot_news
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=ai_hot_news_dev
DATABASE_URL=postgresql://ai_hot_news:dev_password@localhost:5432/ai_hot_news_dev?schema=public

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Common ===
NODE_ENV=development
DOMAIN=localhost

# === SP-4.7 Article Extractor ===
FIRECRAWL_API_KEY=                   # required, get from https://firecrawl.dev/app/api-keys
JINA_API_KEY=                        # optional, anonymous works at lower rate
EXTRACT_CONCURRENCY=2                # optional, defaults to 2

# === SP-5 AI Summary + Tags ===
OPENROUTER_API_KEY=                  # required, get from https://openrouter.ai/settings/keys
SUMMARY_MODEL=deepseek/deepseek-v3.2 # optional, default
LLM_BASE_URL=https://openrouter.ai/api/v1  # optional, default (set https://api.openai.com/v1 + SUMMARY_MODEL=gpt-4o-mini for direct OpenAI)
SUMMARY_CONCURRENCY=3                # optional, default 3

# === SP-6 Heat Scoring ===
# Tune these by observing prod heatLevel distribution after two weeks.
HEAT_DECAY_TAU_HOURS=48              # exp(-ageHours / tau) — 48h is the time-decay half-cycle
HEAT_CRON_INTERVAL_MIN=30            # global NTILE recalc cadence
HEAT_BATCH_SIZE=500                  # rows per cron batch (currently unused; reserved for sharding)
HEAT_CONCURRENCY=2                   # BullMQ heat:<id> worker concurrency
INTERACTION_MAX_HN=500               # log-normalizer ceiling for HN
INTERACTION_MAX_REDDIT=5000          # log-normalizer ceiling for Reddit
INTERACTION_MAX_TWITTER=100000       # SP-22 enables; placeholder OK in V1

# === SP-7 pgvector cross-platform merge ===
# Embeddings are routed through OpenRouter, the same provider SP-5 already uses
# for summary — OpenRouter exposes a 100% OpenAI-compatible /embeddings endpoint
# that forwards to the openai/text-embedding-3-small model at the same
# $0.020 / 1M input tokens (no markup). One key, one credit balance, one
# rate-limit pool. Reuses OPENROUTER_API_KEY above; nothing extra to configure
# beyond the optional knobs below.
# Cost reference: ~165 rows/day × ~80 input tokens ≈ $0.008/month — negligible.
EMBED_MODEL=openai/text-embedding-3-small  # optional, default. Schema column is vector(1536); any 1536-d model works.
EMBED_CONCURRENCY=2                        # optional, default 2.

# === SP-13 JWT auth (M6 起步) ===
# 单 admin 账号走 env，无 DB user lookup。schema 的 User 表预留给未来多用户场景。
# 生成 password hash:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# 生成 JWT secret (≥32 字节):
#   openssl rand -base64 48
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                       # required in prod, $2b$12$... 格式
JWT_SECRET=                                 # required in prod, ≥32 chars
JWT_EXPIRES_IN=7d                           # optional, default 7d
COOKIE_DOMAIN=                              # optional, single-host 留空
COOKIE_SECURE=                              # optional, prod 默认 true

# === SP-16 keyword detection ===
KEYWORD_MATCH_CONCURRENCY=2                # BullMQ worker concurrency
KEYWORD_MATCH_BACKSTOP_DAYS=30             # boot backstop window，scan visible row over the past N days

# === SP-10.5 data lifecycle TTL ===
# hot_news.publishedAt 早于 NOW - CLEANUP_HOT_NEWS_DAYS 自动 DELETE。
# heat_history / keyword_hits 通过 schema ON DELETE CASCADE 自动级联。
# heat_history.bucketAt 早于 NOW - CLEANUP_HEAT_HISTORY_DAYS 单独 DELETE
# （hot_news 还活着但 snapshot 已超时的情况）。
# Daily cron 在 CLEANUP_CRON_HOUR_UTC:00 UTC 触发（默认 03:00 UTC = 11AM CST）。
CLEANUP_HOT_NEWS_DAYS=30                   # optional, default 30. 与 SP-10 ?range=30d 上限对齐
CLEANUP_HEAT_HISTORY_DAYS=7                # optional, default 7. SP-11 详情页折线最多 72h
CLEANUP_CRON_HOUR_UTC=3                    # optional, default 3. 0-23 inclusive
