{
  "name": "ai-hot-news",
  "version": "0.0.1",
  "private": true,
  "description": "AI Hot News 热点信息聚合与监控平台",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "bash scripts/dev-up.sh setup",
    "start": "bash scripts/dev-up.sh start",
    "stop": "bash scripts/dev-up.sh stop",
    "dev": "turbo run dev --parallel",
    "dev:reset": "bash scripts/dev-db-reset.sh",
    "build": "turbo run build",
    "lint": "eslint . --no-error-on-unmatched-pattern && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ai-hot-news/db exec prisma generate",
    "db:migrate:dev": "pnpm --filter @ai-hot-news/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @ai-hot-news/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @ai-hot-news/db exec prisma studio",
    "db:seed": "if [ -f ./.env ]; then set -a; . ./.env; set +a; fi && pnpm --filter @ai-hot-news/db exec prisma db seed",
    "db:migrate-sp4": "if [ -f ./.env ]; then set -a; . ./.env; set +a; fi && pnpm --filter @ai-hot-news/db run migrate-sp4",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
